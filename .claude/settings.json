{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(echo *)",
      "Bash(whoami *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(glab issue list *)",
      "Bash(glab mr list *)",
      "Bash(glab repo view *)",
      "Bash(glab api GET *)",
      "Bash(node -v *)",
      "Bash(npm -v *)",
      "Bash(python --version *)",
      "Bash(gcc *)",
      "Bash(g++ *)",
      "Bash(clang *)",
      "Bash(make *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(npm run build *)",
      "Bash(npm run dev *)",
      "Bash(glab auth status *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab issue view *)",
      "Bash(glab ci list *)",
      "Bash(glab ci view *)",
      "Bash(glab ci status *)",
      "Bash(glab label list *)",
      "Bash(glab release list *)",
      "Bash(glab api --method GET *)",
      "mcp__GitLab__get_mcp_server_version",
      "mcp__GitLab__get_project",
      "mcp__GitLab__get_repository_file",
      "mcp__GitLab__list_repository_tree",
      "mcp__GitLab__list_projects",
      "mcp__GitLab__list_groups",
      "mcp__GitLab__list_project_members",
      "mcp__GitLab__get_user",
      "mcp__GitLab__get_commit",
      "mcp__GitLab__list_commits",
      "mcp__GitLab__list_branches",
      "mcp__GitLab__list_tags",
      "mcp__GitLab__list_releases",
      "mcp__GitLab__list_wiki_pages",
      "mcp__GitLab__get_issue",
      "mcp__GitLab__get_work_item",
      "mcp__GitLab__get_work_item_types",
      "mcp__GitLab__get_workitem_notes",
      "mcp__GitLab__list_work_items",
      "mcp__GitLab__get_merge_request",
      "mcp__GitLab__get_merge_request_commits",
      "mcp__GitLab__get_merge_request_diffs",
      "mcp__GitLab__get_merge_request_notes",
      "mcp__GitLab__get_merge_request_pipelines",
      "mcp__GitLab__list_merge_requests",
      "mcp__GitLab__get_pipeline",
      "mcp__GitLab__get_pipeline_jobs",
      "mcp__GitLab__get_job",
      "mcp__GitLab__list_pipelines",
      "mcp__GitLab__search",
      "mcp__GitLab__search_labels",
      "mcp__GitLab__semantic_search"
    ],
    "ask": [
      "Bash(sed -i *)",
      "Bash(sed -i* *)",
      "Bash(sed --in-place *)",
      "Bash(awk *)",
      "Bash(patch *)",
      "Bash(xargs *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(zsh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(lynx *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(cargo install *)",
      "Bash(mise install *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(glab mr create *)",
      "Bash(glab issue create *)",
      "Bash(glab api POST *)",
      "Bash(glab api DELETE *)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "gitlab.com"
      ]
    }
  },
  "autoUpdatesChannel": "stable",
  "theme": "auto",
  "crossSessionInbound": "hold"
}
