Include ~/.colima/ssh_config

# Work
Host gitlab.com
  ForwardAgent yes
  User git
  IdentityFile ~/.ssh/gitlab_work.pub
  IdentitiesOnly yes

# Added by GDK in a box
Host gdk.local
  Hostname localhost
  IdentityFile ~/.ssh/gdk.local_rsa
  User gdk
  Port 2022

# private - to be migrated
Host michi.fyi dnsmichi.com
  ForwardAgent yes
  User michi
  IdentityFile ~/.ssh/gitlab_work.pub
  IdentitiesOnly yes

# All hosts
Host *
  ServerAliveInterval 30
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
